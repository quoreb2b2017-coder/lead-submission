# LeadHub API environment variables
# Local: copy to server/.env. AWS: set these in the service's environment / Secrets Manager.
# Never commit real values.

# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=production            # "development" locally
PORT=8080                      # App Runner/Beanstalk/Docker use 8080; local dev uses 5000
HOST=0.0.0.0
# Proxies in front of the app: 1 = AWS load balancer only, 2 = Vercel rewrite + load balancer
TRUST_PROXY=2

# ── Frontend (CORS) ─────────────────────────────────────────────────────
# Your Vercel URL(s), comma-separated, no trailing slash
CLIENT_URL=https://your-app.vercel.app

# ── Database (MongoDB Atlas) ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=lead_submission

# ── Auth ────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=token
LOGIN_MAX_ATTEMPTS=10          # failed sign-ins per IP per 15 minutes

# ── First admin (used once by: npm run seed) ────────────────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# ── Lead relay (SelectHub production form post URL) ─────────────────────
RELAY_URL=https://prod-relay.herokuapp.com/api/relay
# dry_run = save only, nothing sent · live = POST real leads to the client
RELAY_MODE=dry_run
# form = application/x-www-form-urlencoded · json = application/json
RELAY_CONTENT_TYPE=form
RELAY_TIMEOUT_MS=15000

# ── Two-factor authentication ───────────────────────────────────────────
# Encrypts authenticator secrets at rest. Set once and never change it (changing it disables
# every existing 2FA setup). Generate like JWT_SECRET. Falls back to a key derived from JWT_SECRET.
TWOFA_ENCRYPTION_KEY=replace_with_another_long_random_string

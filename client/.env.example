# ── Production (Vercel) ────────────────────────────────────────────
# URL of the deployed Express API (no trailing slash). /api/* is proxied there.
BACKEND_URL=https://your-api.example.com

# ── Local development (pick one) ───────────────────────────────────
# a) Proxy through Next.js, same as production:
#    BACKEND_URL=http://localhost:5000
# b) Call the API directly (needs CORS + CLIENT_URL on the server):
#    NEXT_PUBLIC_API_URL=http://localhost:5000/api
